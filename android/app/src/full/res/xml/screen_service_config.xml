<?xml version="1.0" encoding="utf-8"?>
<!--
  What the service is allowed to do, in Android's own terms. Read this file to see its limits:
   - packageNames: it only receives events from WhatsApp and WhatsApp Business.
   - canRetrieveWindowContent: it can read the screen. (Needed to read messages.)
   - NO canPerformGestures, NO flagRequestTouchExplorationMode, NO typing events: it cannot click, swipe, or see what you type.
   - flagReportViewIds: lets it recognise WhatsApp's own screen parts (chat name, message text) by name.
   - notificationTimeout: at most one event every 400 ms, to keep battery use low.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowContentChanged|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/screen_service_description"
    android:notificationTimeout="400"
    android:packageNames="com.whatsapp,com.whatsapp.w4b" />
