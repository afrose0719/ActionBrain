{
  "manifest_version": 3,
  "name": "ActionBrain",
  "version": "0.2.0",
  "description": "Send selected text to your ActionBrain Inbox, and get desktop reminders for tasks and commitments that are due.",
  "permissions": ["contextMenus", "storage", "notifications", "alarms"],
  "host_permissions": ["https://jqbdeydalcaltfmdphon.supabase.co/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "ActionBrain" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
