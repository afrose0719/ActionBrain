{
  "manifest_version": 3,
  "name": "ActionBrain",
  "version": "0.1.0",
  "description": "Select text on any page, right-click, and send it to your ActionBrain Inbox.",
  "permissions": ["contextMenus", "storage", "notifications"],
  "host_permissions": ["https://jqbdeydalcaltfmdphon.supabase.co/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "ActionBrain" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
