# Copy this file to .env.local and fill in your values from
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server secret that encrypts users' saved AI keys. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_KEY_ENCRYPTION_KEY=

# --- Google Calendar (optional, read-only). See docs/google-calendar-setup.md ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Privacy contact (recommended before publishing to Google Play / browser stores) ---
# Shown on /privacy, /terms and /delete-account for privacy and deletion requests.
NEXT_PUBLIC_PRIVACY_CONTACT=
