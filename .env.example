# Copy this file to .env.local and fill in your values from
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server secret that encrypts users' saved AI keys. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_KEY_ENCRYPTION_KEY=

# --- Google Calendar (optional, read-only). See docs/google-calendar-setup.md ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Privacy contact (recommended before publishing to Google Play / browser stores) ---
# Shown on /privacy, /terms and /delete-account for privacy and deletion requests.
NEXT_PUBLIC_PRIVACY_CONTACT=

# --- Zero-touch background processing (optional; Milestone 29, see docs/zero-touch.md) ---
# Connection string of the dedicated actionbrain_worker login (Supabase -> Connect -> Transaction pooler, with that user and password).
WORKER_DATABASE_URL=
# Supabase's CA certificate (Database Settings -> SSL Configuration), so the server verifies the database. Newlines may be written as \n.
WORKER_DATABASE_CA=
# Any long random string. Vercel Cron sends it to /api/cron/keepalive; nobody else can trigger that route.
CRON_SECRET=
